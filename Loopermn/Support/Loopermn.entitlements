<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug only. Do NOT enable App Sandbox for this SPM-built app:
	     sandbox keys without a proper development team break WKWebView networking. -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
</dict>
</plist>
